# BEGIN GENESIS DOMAIN REDIRECT
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(?:www\.)?genesiscalendar\.ru(?::[0-9]+)?$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/ [NC]
RewriteRule ^ genesiscalendar-redirect/index.php [END]
</IfModule>
# END GENESIS DOMAIN REDIRECT
