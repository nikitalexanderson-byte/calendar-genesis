# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
/.pnpm-store/
*.tsbuildinfo
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (public template is intentionally committed)
.env*
!.env.example

# vercel
.vercel

/dist/
/dist-beget/
/.wrangler/
/outputs/
/work/

# Beget runtime data and secrets
/server/config.php
/server/var/
/deploy-private/
/sshp.txt
/backups/

# Android signing material
*.jks
*.keystore

# Generated install packages (release notes remain versioned)
/releases/*.apk
/releases/*.aab
!/releases/README.md
